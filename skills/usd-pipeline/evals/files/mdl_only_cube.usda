#usda 1.0
(
    defaultPrim = "Asset"
    upAxis = "Z"
)

def Xform "Asset" {
    def Cube "Box" {
        double size = 1.0
        rel material:binding = </Asset/Looks/MdlOnlyMaterial>
    }

    def Scope "Looks" {
        def Material "MdlOnlyMaterial" {
            token outputs:surface.connect = </Asset/Looks/MdlOnlyMaterial/Shader.outputs:surface>

            def Shader "Shader" {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./missing_material.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                token outputs:surface
            }
        }
    }
}
