#usda 1.0
(
    defaultPrim = "Prop"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Prop" {
    def Cube "Cube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        double size = 0.5
        rel material:binding = </Prop/Materials/Preview>
    }

    def Scope "Materials" {
        def Material "Preview" {
            token outputs:surface.connect = </Prop/Materials/Preview/Shader.outputs:surface>
            def Shader "Shader" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.6, 0.9)
                token outputs:surface
            }
        }
    }
}
