#usda 1.0
(
    defaultPrim = "Prop"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Prop" {
    def Cube "Cube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        double size = 0.5
        rel material:binding = </Prop/Materials/MdlOnly>
    }

    def Scope "Materials" {
        def Material "MdlOnly" {
            token outputs:mdl:surface.connect = </Prop/Materials/MdlOnly/Shader.outputs:out>
            def Shader "Shader" {
                uniform token info:implementationSource = "sourceAsset"
                asset info:mdl:sourceAsset = @./placeholder.mdl@
                token outputs:out
            }
        }
    }
}
